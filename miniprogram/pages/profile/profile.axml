<!-- 个人中心 -->
<view class="container">
  <!-- 用户信息头部 -->
  <view class="brand-header">
    <view class="profile-header">
      <view class="profile-avatar" a:if="{{userInfo}}">
        <text>{{userInfo.name[0]}}</text>
      </view>
      <view class="profile-info">
        <text class="profile-name">{{userInfo.name || '未登录'}}</text>
        <text class="profile-dept">{{userInfo.deptName || ''}} · {{userInfo.phone || ''}}</text>
        <view class="profile-org" a:if="{{hasOrg}}">
          <text class="profile-org-name">🏢 {{orgInfo.name}}</text>
          <text class="profile-org-role">{{orgInfo.role === 'org_admin' ? '管理员' : '成员'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 未加入组织提示 -->
  <view class="card no-org-hint" a:if="{{!hasOrg}}">
    <text class="no-org-hint-text">您还未加入组织</text>
    <button class="btn btn-primary btn-sm" onTap="goToOrgJoin">立即加入</button>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-section" a:for="{{menuSections}}" a:key="title">
    <view class="menu-section-title">{{item.title}}</view>
    <view class="card menu-card">
      <view 
        class="menu-item" 
        a:for="{{item.items}}" 
        a:key="id"
        onTap="onMenuTap"
        data-id="{{item.id}}"
      >
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-name">{{item.name}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="btn btn-default btn-block" onTap="doLogout">退出登录</button>
  </view>

  <view class="safe-bottom"></view>
</view>
