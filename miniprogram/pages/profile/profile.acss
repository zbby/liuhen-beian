/* 个人中心页样式 */
.profile-header {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 4rpx;
}

.profile-dept {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.profile-org {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.profile-org-name {
  font-size: 22rpx;
  color: #FFFFFF;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.profile-org-role {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 未加入组织 */
.no-org-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.no-org-hint-text {
  font-size: 28rpx;
  color: #999999;
}

/* 菜单 */
.menu-section {
  margin-bottom: 8rpx;
}

.menu-section-title {
  font-size: 24rpx;
  color: #999999;
  padding: 16rpx 8rpx 8rpx;
  font-weight: 500;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #C0C0C0;
}

/* 退出登录 */
.logout-section {
  margin-top: 32rpx;
  padding: 0 4rpx;
}
