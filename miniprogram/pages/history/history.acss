/* 历史记录页样式 */
.search-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  border: 2rpx solid #E8E8E8;
  box-sizing: border-box;
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  background-color: #0052D9;
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.filter-bar {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
  gap: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.filter-item.active {
  background-color: #0052D9;
  color: #FFFFFF;
  font-weight: 600;
}

.category-bar {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.cat-filter {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666666;
  flex-shrink: 0;
}

.cat-filter.active {
  background-color: #E8F0FE;
  color: #0052D9;
  font-weight: 600;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  align-items: flex-start;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.hi-cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.hi-body {
  flex: 1;
  min-width: 0;
}

.hi-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hi-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.hi-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.hi-creator, .hi-time {
  font-size: 22rpx;
  color: #C0C0C0;
}

.hi-cat {
  font-size: 20rpx;
  color: #0052D9;
  background-color: #E8F0FE;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
