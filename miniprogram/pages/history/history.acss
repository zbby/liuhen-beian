/* 历史记录页样式 */
.page-header {
  padding: 32rpx 24rpx;
  background-color: #1890FF;
  color: #FFFFFF;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
  margin-top: 8rpx;
}

.filter-bar {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  gap: 32rpx;
}

.filter-item {
  font-size: 28rpx;
  color: #666666;
  padding: 8rpx 0;
  position: relative;
}

.filter-item.active {
  color: #1890FF;
  font-weight: 600;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #1890FF;
  border-radius: 2rpx;
}

.history-list {
  background-color: #FFFFFF;
  border-radius: 12rpx;
}

.history-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-left {
  margin-right: 24rpx;
}

.history-category {
  width: 8rpx;
  height: 80rpx;
  border-radius: 4rpx;
}

.history-content {
  flex: 1;
}

.history-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
}

.history-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.history-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.history-status {
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state-icon {
  font-size: 120rpx;
  color: #D9D9D9;
  margin-bottom: 24rpx;
}

.empty-state-text {
  font-size: 30rpx;
  color: #666666;
}
