/* 详情页样式 */
.header-card {
  background: linear-gradient(135deg, #1890FF 0%, #096dd9 100%);
  border-radius: 12rpx;
  padding: 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.status-badge {
  display: inline-block;
  margin-bottom: 16rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}

.event-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.event-meta {
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
  opacity: 0.9;
  gap: 8rpx;
}

.section {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.section-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

/* 附件列表 */
.attachment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.attachment-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.attachment-thumb {
  width: 100%;
  height: 100%;
}

/* 审批模式标签 */
.approval-mode-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

/* 时间轴 */
.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background-color: #E8E8E8;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item.completed .timeline-dot {
  background-color: #52c41a;
  border-color: #52c41a;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 2rpx solid #D9D9D9;
}

.timeline-content {
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 20rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.timeline-role {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.timeline-status {
  font-size: 26rpx;
  color: #1890FF;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #999999;
}

.timeline-comment {
  font-size: 26rpx;
  color: #333333;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #E8E8E8;
}

/* 通知列表 */
.notify-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.notify-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
}

.notify-status {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.notify-status.notified {
  color: #52c41a;
}

/* 日志列表 */
.log-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.log-item {
  display: flex;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.log-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.log-time {
  width: 280rpx;
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}

.log-content {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #E8E8E8;
  gap: 24rpx;
}

.action-bar .btn {
  flex: 1;
}
