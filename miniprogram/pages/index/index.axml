<!-- 首页 -->
<view class="container">
  <!-- 品牌头部 -->
  <view class="brand-header">
    <view class="header-top">
      <view>
        <text class="brand-title">留痕备案</text>
        <text class="brand-subtitle">安全合规 · 全程留痕 · 状态跟随</text>
      </view>
      <view class="header-user" a:if="{{userName}}">
        <text class="user-avatar">{{userName[0]}}</text>
      </view>
    </view>
    <view class="header-org" a:if="{{hasOrg}}">
      <text class="org-badge">{{orgName}}</text>
    </view>
  </view>

  <!-- 未加入组织提示 -->
  <view class="card no-org-card" a:if="{{!hasOrg}}">
    <text class="no-org-icon">📋</text>
    <text class="no-org-title">您还未加入组织</text>
    <text class="no-org-desc">创建或加入一个组织后即可开始使用留痕备案功能</text>
    <button class="btn btn-primary btn-sm" onTap="goToOrgJoin">立即加入</button>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-grid" a:if="{{hasOrg}}">
    <view class="stat-card" onTap="goToCreate">
      <text class="stat-value" style="color: #0052D9">{{pendingCount}}</text>
      <text class="stat-label">我发起的</text>
    </view>
    <view class="stat-card" onTap="goToApproval">
      <text class="stat-value" style="color: #FA8C16">{{approvalCount}}</text>
      <text class="stat-label">待我审批</text>
    </view>
    <view class="stat-card" onTap="goToHistory">
      <text class="stat-value" style="color: #52C41A">{{completedCount}}</text>
      <text class="stat-label">已完结</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions" a:if="{{hasOrg}}">
    <view class="quick-action" onTap="goToCreate">
      <view class="qa-icon qa-icon-blue">
        <text>+</text>
      </view>
      <text class="qa-text">发起备案</text>
    </view>
    <view class="quick-action" onTap="goToApproval">
      <view class="qa-icon qa-icon-orange">
        <text>✓</text>
      </view>
      <text class="qa-text">审批</text>
    </view>
    <view class="quick-action" onTap="goToMaterial">
      <view class="qa-icon qa-icon-green">
        <text>📦</text>
      </view>
      <text class="qa-text">甲供材</text>
    </view>
    <view class="quick-action" onTap="goToHistory">
      <view class="qa-icon qa-icon-purple">
        <text>📚</text>
      </view>
      <text class="qa-text">历史</text>
    </view>
  </view>

  <!-- 进行中事件 -->
  <view a:if="{{hasOrg}}">
    <view class="section-header">
      <text class="section-title">进行中事件</text>
      <text class="section-more" onTap="goToHistory">查看全部 ></text>
    </view>

    <view class="event-list">
      <view 
        class="event-item"
        a:for="{{eventList}}"
        a:key="id"
        onTap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="event-cat-icon" style="background-color: {{item.categoryColor}}">
          <text>{{item.categoryIcon}}</text>
        </view>
        <view class="event-body">
          <view class="event-title">{{item.title}}</view>
          <view class="event-desc">{{item.description}}</view>
          <view class="event-meta">
            <text class="event-time">{{item.createTime}}</text>
            <text class="event-cat">{{item.categoryName}}</text>
            <text class="tag tag-{{item.status}}">{{item.statusText}}</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" a:if="{{eventList.length === 0}}">
        <text class="empty-state-icon">📝</text>
        <text class="empty-state-text">暂无进行中事件</text>
        <text class="empty-state-hint">点击"发起备案"创建第一个事件</text>
      </view>
    </view>
  </view>
</view>
