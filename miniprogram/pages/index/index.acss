/* 首页样式 */
.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-user {
  flex-shrink: 0;
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.header-org {
  margin-top: 16rpx;
}

.org-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
}

/* 未加入组织 */
.no-org-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 28rpx;
}

.no-org-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.no-org-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.no-org-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

/* 统计网格 */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.quick-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qa-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.qa-icon-blue { background: linear-gradient(135deg, #0052D9, #2670E8); }
.qa-icon-orange { background: linear-gradient(135deg, #FA8C16, #FFC53D); }
.qa-icon-green { background: linear-gradient(135deg, #52C41A, #95DE64); }
.qa-icon-purple { background: linear-gradient(135deg, #722ED1, #B37FEB); }

.qa-text {
  font-size: 24rpx;
  color: #333333;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #0052D9;
}

/* 事件列表 */
.event-list {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.event-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.event-item:last-child {
  border-bottom: none;
}

.event-cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.event-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.event-time {
  font-size: 24rpx;
  color: #C0C0C0;
}

.event-cat {
  font-size: 22rpx;
  color: #0052D9;
  background-color: #E8F0FE;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}
