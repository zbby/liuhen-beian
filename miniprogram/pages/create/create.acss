/* 发起页面样式 */
.page-header {
  padding: 32rpx 24rpx;
  background-color: #1890FF;
  color: #FFFFFF;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
  margin-top: 8rpx;
}

.form-section {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.form-hint {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
  margin-left: 16rpx;
}

.form-input {
  height: 88rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #E8E8E8;
}

.form-textarea {
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #E8E8E8;
  min-height: 200rpx;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 分类预览 */
.category-preview {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
}

.category-tag {
  font-size: 28rpx;
  color: #1890FF;
  font-weight: 500;
  margin-right: 16rpx;
}

.category-hint {
  font-size: 24rpx;
  color: #999999;
}

/* 上传区域 */
.upload-section {
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 24rpx;
}

.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.upload-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  border: 2rpx dashed #D9D9D9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
}

.upload-add-icon {
  font-size: 48rpx;
  color: #D9D9D9;
  margin-bottom: 8rpx;
}

.upload-add-text {
  font-size: 24rpx;
  color: #999999;
}

.upload-tips {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 单选按钮 */
.radio-group {
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.radio-item:last-child {
  margin-bottom: 0;
}

.radio-item.selected {
  background-color: #FFFFFF;
}

.radio-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D9D9D9;
  margin-right: 16rpx;
  position: relative;
}

.radio-dot.active {
  border-color: #1890FF;
}

.radio-dot.active::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #1890FF;
}

.radio-label {
  font-size: 28rpx;
  color: #333333;
}

/* 模板选择 */
.template-section {
  margin-bottom: 24rpx;
}

.template-title {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.template-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.template-item {
  padding: 12rpx 24rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid transparent;
}

.template-item.selected {
  background-color: #e6f7ff;
  border-color: #1890FF;
  color: #1890FF;
}

/* 审批人列表 */
.approvers-section {
  background-color: #F5F5F5;
  border-radius: 8rpx;
  padding: 16rpx;
}

.approvers-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.approver-tag {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
  border: 1rpx solid #E8E8E8;
}

.approver-delete {
  margin-left: 12rpx;
  color: #999999;
  font-size: 32rpx;
}

.approver-add {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #1890FF;
  border: 1rpx dashed #1890FF;
}

/* 提交区域 */
.submit-section {
  margin-top: 48rpx;
}

.submit-tips {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 按钮禁用状态 */
.btn[disabled] {
  background-color: #D9D9D9 !important;
  color: #FFFFFF !important;
}
