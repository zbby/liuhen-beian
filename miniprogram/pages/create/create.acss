/* 发起页面样式 */
.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 分类预览 */
.category-preview {
  display: flex;
  align-items: center;
  background-color: #F5F6FA;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.cat-icon {
  font-size: 32rpx;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
}

.cat-confidence {
  font-size: 22rpx;
  color: #999999;
  margin-left: auto;
}

.cat-source {
  font-size: 22rpx;
  color: #C0C0C0;
}

/* 上传区域 */
.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-file-preview {
  width: 100%;
  height: 100%;
  background-color: #F0F2F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
}

.upload-file-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.upload-file-name {
  font-size: 18rpx;
  color: #666666;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140rpx;
}

.upload-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.upload-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #D9D9D9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FAFAFA;
}

.upload-add-icon {
  font-size: 44rpx;
  color: #D9D9D9;
  margin-bottom: 4rpx;
}

.upload-add-text {
  font-size: 22rpx;
  color: #999999;
}

.upload-tips {
  font-size: 22rpx;
  color: #C0C0C0;
  margin-top: 16rpx;
}

/* 单选 */
.radio-group {
  background-color: #F5F6FA;
  border-radius: 12rpx;
  padding: 12rpx;
}

.radio-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
  transition: background-color 0.2s;
}

.radio-item:last-child {
  margin-bottom: 0;
}

.radio-item.selected {
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 82, 217, 0.1);
}

.radio-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D9D9D9;
  margin-right: 16rpx;
  position: relative;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.radio-dot.active {
  border-color: #0052D9;
}

.radio-dot.active::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #0052D9;
}

.radio-info {
  flex: 1;
}

.radio-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  display: block;
}

.radio-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-top: 4rpx;
}

/* 模板选择 */
.template-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.template-item {
  padding: 12rpx 24rpx;
  background-color: #F5F6FA;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid transparent;
}

.template-item.selected {
  background-color: #E8F0FE;
  border-color: #0052D9;
  color: #0052D9;
}

/* 审批人列表 */
.approvers-section {
  background-color: #F5F6FA;
  border-radius: 12rpx;
  padding: 16rpx;
}

.approvers-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.approver-tag {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
  border: 1rpx solid #E8E8E8;
}

.approver-delete {
  margin-left: 12rpx;
  color: #C0C0C0;
  font-size: 32rpx;
}

.approver-add {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #0052D9;
  border: 1rpx dashed #0052D9;
}

/* 提交 */
.submit-section {
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.submit-tips {
  text-align: center;
  font-size: 22rpx;
  color: #C0C0C0;
  margin-top: 16rpx;
  line-height: 1.5;
}
