<!-- 发起留痕报备 -->
<view class="container">
  <view class="brand-header">
    <text class="brand-title">发起备案</text>
    <text class="brand-subtitle">填写事件信息，提交后 Ding 通知相关人员</text>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="form-group">
      <view class="form-label">
        事件标题<span class="required">*</span>
      </view>
      <input 
        class="form-input" 
        placeholder="如：服务器配置变更备案"
        value="{{title}}"
        onInput="onTitleInput"
        maxlength="100"
      />
    </view>

    <view class="form-group">
      <view class="form-label">
        事件描述<span class="required">*</span>
      </view>
      <textarea 
        class="form-textarea" 
        placeholder="请详细描述事件内容，系统将自动分类..."
        value="{{description}}"
        onInput="onDescriptionInput"
        maxlength="2000"
      />
      <view class="char-count">{{descriptionLength}}/2000</view>
    </view>

    <!-- 自动分类预览 -->
    <view class="form-group" a:if="{{autoCategory}}">
      <view class="form-label">系统分类</view>
      <view class="category-preview">
        <text class="cat-icon">{{autoCategory.icon}}</text>
        <text class="cat-name" style="color: {{autoCategory.color}}">{{autoCategory.categoryName}}</text>
        <text class="cat-confidence">置信度 {{autoCategoryConfidence >= 0 ? autoCategoryConfidence * 100 : 0}}%</text>
        <text class="cat-source">({{autoCategory.source === 'keyword' ? '关键词匹配' : autoCategory.source === 'event_type' ? '类型指定' : '默认'}})</text>
      </view>
    </view>
  </view>

  <!-- 附件上传 -->
  <view class="card">
    <view class="form-group">
      <view class="form-label">
        附件
        <text class="form-hint">支持图片、音频、视频等</text>
      </view>
      <view class="upload-grid">
        <!-- 已选附件 -->
        <view class="upload-item" a:for="{{attachments}}" a:key="id">
          <image a:if="{{item.type === 'image'}}" class="upload-preview" src="{{item.preview}}" mode="aspectFill" onTap="previewImage" data-index="{{index}}" />
          <view a:elif="{{item.type === 'video'}}" class="upload-file-preview">
            <text class="upload-file-icon">🎬</text>
            <text class="upload-file-name">{{item.name}}</text>
          </view>
          <view a:elif="{{item.type === 'audio'}}" class="upload-file-preview">
            <text class="upload-file-icon">🎵</text>
            <text class="upload-file-name">{{item.name}}</text>
          </view>
          <view a:else class="upload-file-preview">
            <text class="upload-file-icon">📄</text>
            <text class="upload-file-name">{{item.name}}</text>
          </view>
          <view class="upload-delete" onTap="removeAttachment" data-index="{{index}}">×</view>
        </view>

        <!-- 上传入口 -->
        <view class="upload-add" onTap="chooseImage">
          <text class="upload-add-icon">+</text>
          <text class="upload-add-text">图片</text>
        </view>
        <view class="upload-add" onTap="chooseFile">
          <text class="upload-add-icon">📎</text>
          <text class="upload-add-text">文件</text>
        </view>
      </view>
      <view class="upload-tips">最多 20 个附件，单个文件最大 200MB</view>
    </view>
  </view>

  <!-- 审批配置 -->
  <view class="card">
    <!-- 审批模式 -->
    <view class="form-group">
      <view class="form-label">
        审批模式<span class="required">*</span>
      </view>
      <view class="radio-group">
        <view 
          class="radio-item {{approvalMode === item.value ? 'selected' : ''}}"
          a:for="{{approvalModes}}"
          a:key="value"
          onTap="selectApprovalMode"
          data-value="{{item.value}}"
        >
          <view class="radio-dot {{approvalMode === item.value ? 'active' : ''}}"></view>
          <view class="radio-info">
            <text class="radio-label">{{item.label}}</text>
            <text class="radio-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 审批模板 -->
    <view class="form-group">
      <view class="form-label">
        审批模板
        <text class="form-hint">选择预设模板或自定义</text>
      </view>
      <view class="template-list">
        <view 
          class="template-item {{selectedTemplateId === item.id ? 'selected' : ''}}"
          a:for="{{approvalTemplates}}"
          a:key="id"
          onTap="selectTemplate"
          data-id="{{item.id}}"
        >
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 审批人选择（非仅知会模式）-->
    <view class="form-group" a:if="{{approvalMode !== 'notifyOnly'}}">
      <view class="form-label">
        审批人
        <text class="form-hint">可手动添加或使用模板自动指派</text>
      </view>
      <view class="approvers-section">
        <view class="approvers-list">
          <view class="approver-tag" a:for="{{approvers}}" a:key="id">
            <text>{{item.name}}</text>
            <text class="approver-delete" onTap="removeApprover" data-index="{{index}}">×</text>
          </view>
          <view class="approver-add" onTap="chooseApprover">
            <text>+ 添加</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 通知人员 -->
    <view class="form-group">
      <view class="form-label">
        通知人员
        <text class="form-hint">事件发起时 Ding 通知（可选）</text>
      </view>
      <view class="approvers-list">
        <view class="approver-tag" a:for="{{notifyUsers}}" a:key="id">
          <text>{{item.name}}</text>
          <text class="approver-delete" onTap="removeNotifyUser" data-index="{{index}}">×</text>
        </view>
        <view class="approver-add" onTap="chooseNotifyUser">
          <text>+ 通知人</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交 -->
  <view class="submit-section">
    <button class="btn btn-primary btn-block" onTap="submitEvent" disabled="{{!canSubmit || submitting}}">
      {{submitting ? '提交中...' : '提交备案'}}
    </button>
    <view class="submit-tips">
      <text>提交后将 Ding 通知审批人和通知人，其他状态变更走静默通知</text>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
