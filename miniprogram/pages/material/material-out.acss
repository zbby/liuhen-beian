/* 甲供材出库样式 - 复用入库样式 */
.category-preview { display: flex; align-items: center; background-color: #F5F6FA; border-radius: 12rpx; padding: 16rpx 24rpx; gap: 12rpx; }
.cat-icon { font-size: 32rpx; }
.cat-name { font-size: 28rpx; font-weight: 600; }
.upload-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.upload-item { position: relative; width: 160rpx; height: 160rpx; border-radius: 12rpx; overflow: hidden; }
.upload-preview { width: 100%; height: 100%; }
.upload-delete { position: absolute; top: 4rpx; right: 4rpx; width: 36rpx; height: 36rpx; background-color: rgba(0,0,0,0.5); color: #FFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.upload-add { width: 160rpx; height: 160rpx; border-radius: 12rpx; border: 2rpx dashed #D9D9D9; display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: #FAFAFA; }
.upload-add-icon { font-size: 44rpx; color: #D9D9D9; }
.upload-add-text { font-size: 22rpx; color: #999; }
