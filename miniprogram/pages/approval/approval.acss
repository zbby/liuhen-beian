/* 审批列表页样式 */
.page-header {
  padding: 32rpx 24rpx;
  background-color: #1890FF;
  color: #FFFFFF;
  margin: -24rpx -24rpx 24rpx -24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  display: block;
  margin-top: 8rpx;
}

.approval-list {
  background-color: #FFFFFF;
  border-radius: 12rpx;
}

.approval-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.approval-item:last-child {
  border-bottom: none;
}

.approval-left {
  margin-right: 24rpx;
}

.approval-category {
  width: 8rpx;
  height: 100rpx;
  border-radius: 4rpx;
}

.approval-content {
  flex: 1;
}

.approval-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.approval-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.approval-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.approval-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.approval-mode {
  background-color: #fff7e6;
  color: #fa8c16;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state-icon {
  font-size: 120rpx;
  color: #D9D9D9;
  margin-bottom: 24rpx;
}

.empty-state-text {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.empty-state-hint {
  font-size: 26rpx;
  color: #999999;
}
