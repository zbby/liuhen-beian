/* 审批列表页样式 */
.filter-bar {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  gap: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #666666;
}

.filter-item.active {
  background-color: #0052D9;
  color: #FFFFFF;
  font-weight: 600;
}

.approval-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.approval-item {
  display: flex;
  align-items: flex-start;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.ap-cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ap-body {
  flex: 1;
  min-width: 0;
}

.ap-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ap-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ap-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.ap-creator, .ap-time {
  font-size: 24rpx;
  color: #C0C0C0;
}

.ap-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.ap-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.ap-tag.cat {
  background-color: #E8F0FE;
  color: #0052D9;
}

.ap-tag.mode {
  background-color: #FFF7E6;
  color: #FA8C16;
}

.ap-arrow {
  font-size: 32rpx;
  color: #C0C0C0;
  flex-shrink: 0;
  margin-top: 16rpx;
}
