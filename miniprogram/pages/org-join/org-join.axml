<!-- 组织注册/加入 -->
<view class="container">
  <view class="brand-header">
    <text class="brand-title">欢迎使用留痕报备</text>
    <text class="brand-subtitle">请创建或加入一个组织开始使用</text>
  </view>

  <!-- 选择步骤 -->
  <view class="step-choose" a:if="{{step === 'choose'}}">
    <view class="choice-card" onTap="switchStep" data-step="create">
      <view class="choice-icon create-icon">
        <text>+</text>
      </view>
      <view class="choice-info">
        <text class="choice-title">创建组织</text>
        <text class="choice-desc">新建一个留痕报备组织，成为管理员</text>
      </view>
      <text class="choice-arrow">></text>
    </view>

    <view class="choice-card" onTap="switchStep" data-step="join">
      <view class="choice-icon join-icon">
        <text>S</text>
      </view>
      <view class="choice-info">
        <text class="choice-title">加入组织</text>
        <text class="choice-desc">搜索组织名称，申请加入</text>
      </view>
      <text class="choice-arrow">></text>
    </view>

    <view class="tips-card">
      <view class="tips-title">关于组织</view>
      <view class="tips-item">· 组织是留痕报备的基本单位，事件在组织内流转</view>
      <view class="tips-item">· 搜索组织名称即可加入，无需邀请码</view>
      <view class="tips-item">· 组织管理员可管理成员、配置审批模板</view>
      <view class="tips-item">· 数据在组织范围内隔离，符合信息安全要求</view>
    </view>
  </view>

  <!-- 创建组织 -->
  <view class="step-form" a:if="{{step === 'create'}}">
    <view class="card">
      <view class="form-group">
        <view class="form-label">
          组织名称<span class="required">*</span>
        </view>
        <input 
          class="form-input" 
          placeholder="如：XX公司安全合规部"
          value="{{orgName}}"
          onInput="onOrgNameInput"
          maxlength="50"
        />
      </view>

      <view class="form-group">
        <view class="form-label">组织描述</view>
        <textarea 
          class="form-textarea" 
          placeholder="简要描述组织用途（选填）"
          value="{{orgDesc}}"
          onInput="onOrgDescInput"
          maxlength="200"
        />
      </view>

      <button class="btn btn-primary btn-block" onTap="createOrg" disabled="{{submitting}}">
        创建组织
      </button>
      <view class="form-back" onTap="switchStep" data-step="choose">
        <text>返回</text>
      </view>
    </view>
  </view>

  <!-- 搜索加入组织 -->
  <view class="step-form" a:if="{{step === 'join'}}">
    <view class="card">
      <view class="form-group">
        <view class="form-label">
          搜索组织<span class="required">*</span>
        </view>
        <input 
          class="form-input" 
          placeholder="输入组织名称搜索"
          value="{{searchKeyword}}"
          onInput="onSearchInput"
          maxlength="50"
        />
        <view class="form-hint-block">
          输入组织名称或关键词即可搜索并加入
        </view>
      </view>

      <!-- 搜索结果列表 -->
      <view class="search-results" a:if="{{searchKeyword}}">
        <!-- 搜索中 -->
        <view class="search-loading" a:if="{{searching}}">
          <text>搜索中...</text>
        </view>

        <!-- 结果列表 -->
        <block a:elif="{{searchResults.length > 0}}">
          <view 
            class="org-item"
            a:for="{{searchResults}}"
            a:key="org_id"
            onTap="onOrgTap"
            data-id="{{item.org_id}}"
            data-name="{{item.name}}"
          >
            <view class="org-item-icon">
              <text>O</text>
            </view>
            <view class="org-item-info">
              <text class="org-item-name">{{item.name}}</text>
              <text class="org-item-meta">组织ID: {{item.org_code}}</text>
            </view>
            <view class="org-item-action {{submitting ? 'disabled' : ''}}">
              <text>加入</text>
            </view>
          </view>
        </block>

        <!-- 无结果 -->
        <view class="search-empty" a:elif="{{!searching}}">
          <text class="search-empty-text">未找到匹配的组织</text>
          <text class="search-empty-hint">请检查名称或尝试其他关键词</text>
        </view>
      </view>

      <view class="form-back" onTap="switchStep" data-step="choose">
        <text>返回</text>
      </view>
    </view>
  </view>
</view>
