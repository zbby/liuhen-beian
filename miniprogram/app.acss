/* ============================================
 * 留痕报备 - 全局样式
 * 主题色：科技蓝 #0052D9
 * ============================================ */

page {
  background-color: #F5F6FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
}

/* ===== 容器 ===== */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 品牌头部 ===== */
.brand-header {
  background: linear-gradient(135deg, #0052D9 0%, #2670E8 100%);
  padding: 40rpx 32rpx 48rpx;
  margin: -24rpx -24rpx 24rpx;
  color: #FFFFFF;
  border-radius: 0 0 24rpx 24rpx;
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* ===== 卡片 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999999;
}

/* ===== 按钮 ===== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: opacity 0.2s;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #0052D9;
  color: #FFFFFF;
}

.btn-primary:active {
  background-color: #003DA5;
}

.btn-default {
  background-color: #FFFFFF;
  color: #0052D9;
  border: 2rpx solid #0052D9;
}

.btn-default:active {
  background-color: #E8F0FE;
}

.btn-danger {
  background-color: #F5222D;
  color: #FFFFFF;
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

.btn[disabled] {
  background-color: #D9D9D9 !important;
  color: #FFFFFF !important;
  border: none !important;
}

/* ===== 表单 ===== */
.form-group {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.form-label .required {
  color: #F5222D;
  margin-left: 4rpx;
}

.form-hint {
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
  margin-left: 16rpx;
}

.form-input {
  height: 88rpx;
  background-color: #F5F6FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: #0052D9;
  background-color: #FFFFFF;
}

.form-textarea {
  background-color: #F5F6FA;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  min-height: 200rpx;
  line-height: 1.6;
  transition: border-color 0.2s;
}

.form-textarea:focus {
  border-color: #0052D9;
  background-color: #FFFFFF;
}

/* ===== 列表 ===== */
.list-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  background-color: #0052D9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  flex-shrink: 0;
}

.list-item-content {
  flex: 1;
  min-width: 0;
}

.list-item-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.list-item-desc {
  font-size: 26rpx;
  color: #999999;
}

.list-item-arrow {
  color: #C0C0C0;
  font-size: 32rpx;
  flex-shrink: 0;
}

/* ===== 状态标签 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.tag-draft { background-color: #F5F5F5; color: #8C8C8C; }
.tag-pending_approval { background-color: #FFF7E6; color: #FA8C16; }
.tag-processing { background-color: #E6F7FF; color: #1890FF; }
.tag-completed { background-color: #F6FFED; color: #52C41A; }
.tag-rejected { background-color: #FFF1F0; color: #F5222D; }
.tag-archived { background-color: #F0F5FF; color: #2F54EB; }
.tag-withdrawn { background-color: #F5F5F5; color: #8C8C8C; }

/* ===== 分类标签 ===== */
.cat-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-state-text {
  font-size: 28rpx;
  color: #999999;
}

.empty-state-hint {
  font-size: 24rpx;
  color: #C0C0C0;
  margin-top: 8rpx;
}

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #999999;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background-color: #F0F0F0;
  margin: 24rpx 0;
}

/* ===== 安全区底部 ===== */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}

/* ===== 隐藏 ===== */
.hidden {
  display: none !important;
}
